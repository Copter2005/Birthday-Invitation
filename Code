                    </div>

                    <!-- ACTION BUTTON: "รับด้วยเกล้า" -->
                    <div id="acceptActionArea" class="mt-9 sm:mt-11 flex flex-col items-center">
                        <button id="acceptEdictBtn" type="button"
                            class="w-full sm:w-auto min-w-[240px] px-8 py-4 rounded-xl bg-gradient-to-b from-red-700 via-red-800 to-red-950 hover:from-red-600 hover:to-red-900 text-amber-200 font-bold text-lg sm:text-xl tracking-wider border-2 border-amber-400 shadow-xl flex items-center justify-center gap-2.5 transition transform active:scale-95 cursor-pointer">
