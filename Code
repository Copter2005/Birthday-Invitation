                        </div>

                        <!-- Utility Buttons: Google Maps & Add to Calendar -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-4">
                            <a href="https://www.google.com/maps/search/?api=1&query=Shabu+Moto+Ari" target="_blank" rel="noopener noreferrer"
                               class="px-4 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-red-950 font-bold text-xs sm:text-sm text-center flex items-center justify-center gap-1.5 transition active:scale-95">
