<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>พระบรมราชโองการ — 奉天承运皇帝，敕曰</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Thai Royal Serif & Traditional Chinese Calligraphy -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+TC:wght@600;700;900&family=Noto+Serif+Thai:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --imperial-gold: #f4cf6a;
            --imperial-silk: #f6d575;
            --imperial-silk-dark: #dfb043;
            --vermilion: #b51d14;
            --vermilion-bright: #d92b1e;
            --palace-red: #3d0909;
            --palace-dark: #1f0404;
            --jade-roller: #2e4a3d;
            --wood-roller: #3b1c0e;
        }

        body {
            font-family: 'Noto Serif Thai', serif;
            background-color: #f3ce68;
            background-image: 
                /* Subtle silk weave */
                repeating-linear-gradient(0deg, rgba(255,255,255,0.14) 0px, rgba(255,255,255,0.14) 1px, transparent 1px, transparent 3px),
                repeating-linear-gradient(90deg, rgba(184,134,11,0.09) 0px, rgba(184,134,11,0.09) 1px, transparent 1px, transparent 3px),
                /* Auspicious gradient sheen */
                linear-gradient(135deg, rgba(255,243,196,0.5) 0%, rgba(235,186,66,0.25) 50%, rgba(196,140,28,0.35) 100%);
            box-shadow: inset 0 0 40px rgba(146, 94, 12, 0.35);
            min-height: 100dvh;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            color: #2b1808;
            -webkit-tap-highlight-color: transparent;
        }

        .font-chinese-calligraphy {
            font-family: 'Ma Shan Zheng', 'Noto Serif TC', serif;
        }

        .font-chinese-serif {
            font-family: 'Noto Serif TC', serif;
        }

        /* Imperial Ming Yellow Brocade Silk Texture (Full-Bleed) */
        .imperial-silk-bg {
            background-color: #f3ce68;
            background-image: 
                repeating-linear-gradient(0deg, rgba(255,255,255,0.14) 0px, rgba(255,255,255,0.14) 1px, transparent 1px, transparent 3px),
                repeating-linear-gradient(90deg, rgba(184,134,11,0.09) 0px, rgba(184,134,11,0.09) 1px, transparent 1px, transparent 3px),
                linear-gradient(135deg, rgba(255,243,196,0.5) 0%, rgba(235,186,66,0.25) 50%, rgba(196,140,28,0.35) 100%);
        }

        /* Top & Bottom Wooden/Jade Rollers (轴) - Full 100vw Edge-to-Edge */
        .scroll-roller {
            background: linear-gradient(180deg, 
                #5c2e16 0%, 
                #8c4a27 22%, 
                #47200d 55%, 
                #260f05 88%, 
                #4a220e 100%);
            box-shadow: 
                0 6px 16px rgba(0, 0, 0, 0.45),
                inset 0 2px 3px rgba(255, 215, 130, 0.35);
            position: relative;
            z-index: 20;
        }

        /* Golden End-Caps on Rollers (轴头) */
        .roller-cap-left, .roller-cap-right {
            background: linear-gradient(180deg, 
                #fce28b 0%, 
                #d49b27 30%, 
                #8f610d 75%, 
                #c99122 100%);
            box-shadow: 0 3px 8px rgba(0,0,0,0.45);
            border-top: 1px solid #6e4906;
            border-bottom: 1px solid #6e4906;
        }

        /* Scroll Unrolling Transition */
        .scroll-body-wrapper {
            max-height: 0px;
            opacity: 0;
            overflow: hidden;
            transition: max-height 1.75s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.75s ease-in;
        }

        .scroll-body-wrapper.unrolled {
            max-height: 3000px;
            opacity: 1;
        }

        /* Closed Scroll Ribbon & Seal Button */
        .closed-clasp-container {
            transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .closed-clasp-container.hidden-clasp {
            opacity: 0;
            transform: scale(0.75);
            pointer-events: none;
        }

        /* Imperial Pulse Animation */
        @keyframes imperialPulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(217, 43, 30, 0.7), 0 8px 25px rgba(0,0,0,0.6);
                transform: scale(1);
            }
            50% {
                box-shadow: 0 0 0 14px rgba(217, 43, 30, 0), 0 12px 30px rgba(181, 29, 20, 0.8);
                transform: scale(1.03);
            }
        }

        .btn-receive-edict {
            animation: imperialPulse 2.4s infinite ease-in-out;
            background: radial-gradient(circle at 30% 30%, #d92b1e 0%, #99130b 85%, #6e0b05 100%);
            border: 3px solid #f7d56e;
            box-shadow: inset 0 0 12px rgba(255, 223, 128, 0.45);
        }

        .btn-receive-edict:active {
            transform: scale(0.96);
        }

        /* Zhuwen (朱文) Small Seal Script Stamp Styling */
        .imperial-seal-box {
            border: 3.5px solid #b81d13;
            background-color: rgba(247, 214, 118, 0.22);
            box-shadow: 
                inset 0 0 0 1.5px rgba(184, 29, 19, 0.35),
                0 1px 3px rgba(184, 29, 19, 0.25);
            transform: rotate(-1.5deg);
            filter: contrast(1.08);
            user-select: none;
        }

        /* Subtle Ink Distress Overlay */
        .seal-ink-texture {
            background-image: radial-gradient(rgba(243, 206, 104, 0.35) 1px, transparent 0);
            background-size: 5px 5px;
        }

        /* Floating Golden Petals Canvas */
        #celebrationCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
        }

        /* Text Fade-in Stagger after unroll */
        .edict-content-fade {
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 1s ease 0.65s, transform 1s ease 0.65s;
        }

        .scroll-body-wrapper.unrolled .edict-content-fade {
            opacity: 1;
            transform: translateY(0);
        }

        /* Highlighted Guest Name */
        .guest-name-highlight {
            color: #9e160e;
            font-weight: 800;
            border-bottom: 1.5px dashed rgba(158, 22, 14, 0.5);
            padding: 0 3px;
            display: inline-block;
        }
    </style>
</head>
<body class="min-h-[100dvh] w-full flex flex-col justify-between selection:bg-red-800 selection:text-amber-200">

    <!-- Celebration Particle Canvas -->
    <canvas id="celebrationCanvas"></canvas>

    <!-- Top Subtle Host & Audio Controls -->
    <div class="fixed top-11 right-3 z-40 flex items-center gap-2">
        <!-- Sound Toggle -->
        <button id="soundToggleBtn" type="button" aria-label="เปิด/ปิดเสียง"
            class="p-2 rounded-full bg-red-950/80 hover:bg-red-950 text-amber-200 border border-amber-400/50 shadow-md backdrop-blur-sm transition active:scale-95"
