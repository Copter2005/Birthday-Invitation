                                        <path d="M19 102 H47"/>
                                        <path d="M26 106 L20 112"/>
                                        <path d="M40 106 L46 112"/>
                                    </g>
                                </svg>
                            </div>
                            <span class="text-[11px] font-chinese-serif text-red-900/80 mt-1 tracking-widest">敕命之寶</span>
