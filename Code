                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>เปิดแผนที่ร้าน</span>
                            </a>

                            <button id="downloadIcsBtn" type="button"
                                class="px-4 py-2.5 rounded-lg bg-red-800 hover:bg-red-700 text-amber-200 font-semibold text-xs sm:text-sm border border-amber-400/50 flex items-center justify-center gap-1.5 transition active:scale-95">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <span>บันทึกลงปฏิทิน</span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- BOTTOM FULL-WIDTH SCROLL ROLLER (下轴) -->
        <div class="w-full flex items-center justify-center select-none shrink-0">
            <div class="roller-cap-left w-4 sm:w-6 h-8 sm:h-10 shrink-0"></div>
            <div class="scroll-roller w-full h-7 sm:h-9 flex items-center justify-center">
                <div class="w-full h-[1px] bg-amber-300/25"></div>
            </div>
            <div class="roller-cap-right w-4 sm:w-6 h-8 sm:h-10 shrink-0"></div>
        </div>

    </main>

    <!-- HOST PERSONALIZATION MODAL (สำหรับเจ้าของงานสร้างลิงก์แยกตามชื่อแขกแต่ละคน) -->
    <div id="hostModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
        <div class="w-full max-w-md rounded-2xl bg-stone-900 border-2 border-amber-500/60 p-5 sm:p-6 text-amber-100 shadow-2xl">
            <div class="flex items-center justify-between border-b border-amber-500/25 pb-3 mb-4">
                <h3 class="font-bold text-base sm:text-lg text-amber-300 flex items-center gap-2">
                    <span>📜</span>
                    <span>ตั้งค่าชื่อผู้ได้รับเชิญ (สร้างลิงก์รายบุคคล)</span>
                </h3>
                <button id="closeHostModalBtn" type="button" class="p-1.5 rounded-lg hover:bg-white/10 text-amber-300">
                    ✕
                </button>
            </div>

            <p class="text-xs sm:text-sm text-amber-200/80 mb-3 leading-relaxed">
                พิมพ์ชื่อแขกที่ต้องการเชิญ ระบบจะใส่ชื่อลงในพระบรมราชโองการให้อัตโนมัติทั้ง 2 ตำแหน่ง พร้อมสร้างลิงก์เฉพาะสำหรับส่งให้แขกคนนั้น
            </p>

            <label for="guestNameInput" class="block text-xs font-semibold text-amber-300 mb-1.5">
                ชื่อ / ยศตำแหน่งของแขก:
            </label>
            <input id="guestNameInput" type="text" placeholder="เช่น ท่านแม่ทัพสมชาย, คุณพลอย"
                class="w-full px-3.5 py-2.5 rounded-xl bg-black/50 border border-amber-500/50 text-white placeholder-amber-200/35 focus:outline-none focus:border-amber-300 text-sm mb-4">

            <div class="bg-black/40 p-3 rounded-xl border border-amber-500/25 mb-4">
                <span class="block text-[11px] text-amber-300/75 mb-1">ลิงก์เฉพาะสำหรับแขกท่านนี้:</span>
                <div class="flex items-center gap-2">
                    <input id="generatedLinkInput" type="text" readonly
                        class="w-full bg-transparent text-xs text-amber-200 font-mono focus:outline-none truncate">
                    <button id="copyLinkBtn" type="button"
                        class="shrink-0 px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-red-950 font-bold text-xs transition active:scale-95">
                        คัดลอกลิงก์
                    </button>
                </div>
                <p id="copyFeedbackText" class="text-[11px] text-emerald-400 mt-1.5 hidden">
                    ✓ คัดลอกลิงก์เรียบร้อยแล้ว! นำไปส่งให้แขกได้เลย
                </p>
            </div>

            <div class="flex justify-end gap-2">
                <button id="applyNameBtn" type="button"
                    class="w-full py-2.5 rounded-xl bg-red-700 hover:bg-red-600 text-amber-200 font-bold text-sm border border-amber-400/50 transition">
                    อัปเดตชื่อบนหน้านี้
                </button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            // --- 1. Guest Name Management via URL Parameter (?name=...) ---
            const DEFAULT_GUEST_NAME = 'ท่านขุนนางผู้ภักดี';
            const urlParams = new URLSearchParams(window.location.search);
            let currentGuestName = (urlParams.get('name') || '').trim() || DEFAULT_GUEST_NAME;

            const guestNameSlots = document.querySelectorAll('.guest-name-slot');
            const guestNameInput = document.getElementById('guestNameInput');
            const generatedLinkInput = document.getElementById('generatedLinkInput');

            function updateGuestNameDisplay(name) {
                const cleanName = name.trim() || DEFAULT_GUEST_NAME;
                currentGuestName = cleanName;
                guestNameSlots.forEach(slot => {
                    slot.textContent = cleanName;
                });

                // Update URL without reloading
                const newUrl = new URL(window.location.href);
                if (cleanName === DEFAULT_GUEST_NAME) {
                    newUrl.searchParams.delete('name');
                } else {
                    newUrl.searchParams.set('name', cleanName);
                }
                window.history.replaceState({}, '', newUrl.toString());
                if (generatedLinkInput) {
                    generatedLinkInput.value = newUrl.toString();
                }
            }

            // Initialize guest name on load
            updateGuestNameDisplay(currentGuestName);
            if (currentGuestName !== DEFAULT_GUEST_NAME) {
                guestNameInput.value = currentGuestName;
            }

            // --- 2. Synthesized Traditional Chinese Chime / Guzheng Sound (Web Audio API) ---
            let soundEnabled = true;
            let audioCtx = null;

            function initAudio() {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (AudioContextClass) {
                        audioCtx = new AudioContextClass();
                    }
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            }

            // Chinese Pentatonic Royal Chime (Gong/Shang/Jue/Zhi/Yu)
            function playImperialChime(type = 'unroll') {
                if (!soundEnabled) return;
                try {
                    initAudio();
                    if (!audioCtx) return;

                    const now = audioCtx.currentTime;
                    // Pentatonic frequencies (D4, E4, G4, A4, B4, D5)
                    const notes = type === 'unroll'
                        ? [293.66, 329.63, 392.00, 440.00, 587.33]
                        : [440.00, 587.33, 659.25, 880.00];

                    notes.forEach((freq, idx) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, now + idx * 0.14);

                        gain.gain.setValueAtTime(0.001, now + idx * 0.14);
                        gain.gain.exponentialRampToValueAtTime(0.14, now + idx * 0.14 + 0.04);
                        gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.14 + 1.6);

                        osc.connect(gain);
                        gain.connect(audioCtx.destination);

                        osc.start(now + idx * 0.14);
                        osc.stop(now + idx * 0.14 + 1.65);
                    });
                } catch (e) {
                    // Fail silently if audio blocked
                }
            }

            const soundToggleBtn = document.getElementById('soundToggleBtn');
            const soundOnIcon = document.getElementById('soundOnIcon');
            const soundOffIcon = document.getElementById('soundOffIcon');

            soundToggleBtn.addEventListener('click', () => {
                soundEnabled = !soundEnabled;
                soundOnIcon.classList.toggle('hidden', !soundEnabled);
                soundOffIcon.classList.toggle('hidden', soundEnabled);
            });

            // --- 3. Scroll Unrolling Logic ---
            const unrollBtn = document.getElementById('unrollBtn');
            const closedClasp = document.getElementById('closedClasp');
            const closedHeaderHint = document.getElementById('closedHeaderHint');
            const scrollBodyWrapper = document.getElementById('scrollBodyWrapper');

            unrollBtn.addEventListener('click', () => {
                playImperialChime('unroll');

                // Hide clasp & top hint
                closedClasp.classList.add('hidden-clasp');
                closedHeaderHint.style.opacity = '0';

                setTimeout(() => {
                    closedClasp.style.display = 'none';
                    closedHeaderHint.style.display = 'none';
                    scrollBodyWrapper.classList.add('unrolled');
                }, 280);
            });

            // --- 4. "รับด้วยเกล้า" Acceptance & Golden Celebration Particles ---
            const acceptEdictBtn = document.getElementById('acceptEdictBtn');
            const acceptActionArea = document.getElementById('acceptActionArea');
            const acceptedConfirmationCard = document.getElementById('acceptedConfirmationCard');

            acceptEdictBtn.addEventListener('click', () => {
                playImperialChime('accept');
                acceptActionArea.classList.add('hidden');
                acceptedConfirmationCard.classList.remove('hidden');
                launchGoldenCelebration();

                setTimeout(() => {
                    acceptedConfirmationCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }, 150);
            });

            // --- 5. Calendar (.ics) Download for Shabu Moto Ari ---
            const downloadIcsBtn = document.getElementById('downloadIcsBtn');
            downloadIcsBtn.addEventListener('click', () => {
                const icsContent = [
                    'BEGIN:VCALENDAR',
                    'VERSION:2.0',
                    'PRODID:-//Ming Imperial Edict Birthday Invitation//TH',
                    'BEGIN:VEVENT',
                    'DTSTART:20261123T060000Z', // 13:00 Bangkok (UTC+7)
                    'DTEND:20261123T083000Z',   // 15:30 Bangkok (UTC+7)
                    'SUMMARY:งานเลี้ยงฉลองวันเกิด (พระบรมราชโองการเชิญเข้าเฝ้า)',
                    'LOCATION:Shabu Moto Ari, Bangkok',
                    `DESCRIPTION:พระบรมราชโองการเชิญ ${currentGuestName} เข้าเฝ้าร่วมงานเลี้ยงฉลองวันเกิด ณ Shabu Moto Ari วันที่ 23 พฤศจิกายน 2026 เวลา 13.00 น.`,
                    'END:VEVENT',
                    'END:VCALENDAR'
                ].join('\r\n');

                const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'imperial-birthday-invitation.ics';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });

            // --- 6. Host Customization Modal ---
            const hostModal = document.getElementById('hostModal');
            const openHostModalBtn = document.getElementById('openHostModalBtn');
            const closeHostModalBtn = document.getElementById('closeHostModalBtn');
            const applyNameBtn = document.getElementById('applyNameBtn');
            const copyLinkBtn = document.getElementById('copyLinkBtn');
            const copyFeedbackText = document.getElementById('copyFeedbackText');

            openHostModalBtn.addEventListener('click', () => {
                hostModal.classList.remove('hidden');
                hostModal.classList.add('flex');
                copyFeedbackText.classList.add('hidden');
            });

            function closeHostModal() {
                hostModal.classList.add('hidden');
                hostModal.classList.remove('flex');
            }

            closeHostModalBtn.addEventListener('click', closeHostModal);
            hostModal.addEventListener('click', (e) => {
                if (e.target === hostModal) closeHostModal();
            });

            guestNameInput.addEventListener('input', () => {
                const tempUrl = new URL(window.location.href);
                const val = guestNameInput.value.trim();
                if (val) {
                    tempUrl.searchParams.set('name', val);
                } else {
                    tempUrl.searchParams.delete('name');
                }
                generatedLinkInput.value = tempUrl.toString();
                copyFeedbackText.classList.add('hidden');
            });

            applyNameBtn.addEventListener('click', () => {
                updateGuestNameDisplay(guestNameInput.value);
                closeHostModal();
            });

            copyLinkBtn.addEventListener('click', () => {
                updateGuestNameDisplay(guestNameInput.value);
                generatedLinkInput.select();
                generatedLinkInput.setSelectionRange(0, 99999);
                try {
                    document.execCommand('copy');
                    copyFeedbackText.classList.remove('hidden');
                } catch (err) {
                    // Fallback ignored
                }
            });

            // --- 7. Golden Silk & Auspicious Petal Canvas Animation ---
            const canvas = document.getElementById('celebrationCanvas');
            const ctx = canvas.getContext('2d');
            let particles = [];
            let animatingParticles = false;

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            function launchGoldenCelebration() {
                particles = [];
                const colors = ['#f7d56e', '#ffdf85', '#d92b1e', '#f59e0b', '#fde68a'];
                for (let i = 0; i < 85; i++) {
                    particles.push({
                        x: Math.random() * canvas.width,
                        y: -20 - Math.random() * canvas.height * 0.5,
                        size: 5 + Math.random() * 7,
                        speedY: 1.5 + Math.random() * 2.8,
                        speedX: (Math.random() - 0.5) * 1.8,
                        rotation: Math.random() * Math.PI * 2,
                        rotSpeed: (Math.random() - 0.5) * 0.08,
                        color: colors[Math.floor(Math.random() * colors.length)],
                        opacity: 0.95
                    });
                }
                if (!animatingParticles) {
                    animatingParticles = true;
                    animateParticles();
                }
            }

            function animateParticles() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let activeCount = 0;

                particles.forEach(p => {
                    p.y += p.speedY;
                    p.x += p.speedX + Math.sin(p.y * 0.02) * 0.5;
                    p.rotation += p.rotSpeed;

                    if (p.y > canvas.height * 0.8) {
                        p.opacity -= 0.015;
                    }

                    if (p.opacity > 0 && p.y < canvas.height + 30) {
                        activeCount++;
                        ctx.save();
                        ctx.translate(p.x, p.y);
                        ctx.rotate(p.rotation);
                        ctx.globalAlpha = Math.max(0, p.opacity);
                        ctx.fillStyle = p.color;
                        // Draw auspicious diamond/petal shape
                        ctx.beginPath();
                        ctx.moveTo(0, -p.size);
                        ctx.quadraticCurveTo(p.size * 0.8, 0, 0, p.size);
                        ctx.quadraticCurveTo(-p.size * 0.8, 0, 0, -p.size);
                        ctx.fill();
                        ctx.restore();
                    }
                });

                if (activeCount > 0) {
                    requestAnimationFrame(animateParticles);
                } else {
                    animatingParticles = false;
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            }
        })();
    </script>
</body>
