    <!-- Main Full-Bleed Scroll Container (100vw, Zero Outer Margins/Frames) -->
    <main class="w-full min-h-[100dvh] flex flex-col justify-between relative z-10">

        <!-- TOP FULL-WIDTH SCROLL ROLLER (上轴) -->
        <div class="w-full flex items-center justify-center select-none shrink-0">
