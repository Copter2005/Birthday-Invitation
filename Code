        </div>

        <!-- CLOSED STATE: FULL-SCREEN SILK PAPER WITH CENTRAL RIBBON & "รับพระราชโองการ" BUTTON -->
        <div id="closedClasp" class="closed-clasp-container w-full flex-1 flex flex-col items-center justify-center relative px-4 py-10">
            <!-- Vertical Imperial Red Silk Ribbon Band -->
            <div class="absolute inset-y-0 w-16 sm:w-20 bg-gradient-to-r from-red-900 via-red-700 to-red-900 border-x-2 border-amber-400 shadow-lg"></div>

            <!-- Subtle Title Above Seal -->
