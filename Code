        <!-- UNROLLED SCROLL BODY: FULL-BLEED PAPER (ไม่มีกรอบด้านข้าง เต็มพื้นที่หน้าจอ) -->
        <div id="scrollBodyWrapper" class="scroll-body-wrapper w-full flex-1 flex flex-col justify-center">
            <div class="w-full max-w-2xl mx-auto px-5 py-7 sm:px-8 sm:py-10">
                <div class="edict-content-fade">

                    <!-- Imperial Opening Header -->
