                        </div>

                        <!-- Authentic Ming Imperial Seal: 朱文 (Zhuwen) Small Seal Script (小篆) "敕命之寶" -->
                        <div class="flex flex-col items-center shrink-0">
                            <div class="imperial-seal-box seal-ink-texture w-24 h-24 sm:w-28 sm:h-28 p-1.5 rounded-[3px] flex items-center justify-center relative"
